# ARGOS dev stack — copy to .env and fill in your own values
POSTGRES_USER=argos
POSTGRES_PASSWORD=change_me
POSTGRES_DB=argos
MINIO_ROOT_USER=argos
MINIO_ROOT_PASSWORD=change_me
PGADMIN_DEFAULT_EMAIL=you@example.org
PGADMIN_DEFAULT_PASSWORD=change_me
DATABASE_URL=postgresql://argos:change_me@postgis:5432/argos
DATABASE_URL_READ=postgresql://argos_read:change_me@postgis:5432/argos
